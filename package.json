{
    "name": "leannotebook",
    "displayName": "LeanNotebook",
    "description": "Rich notebook interface for Lean 4 based on VanJS",
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ken-okabe/vscode-lean-notebook"
    },
    "publisher": "ken-okabe",
    "activationEvents": [
        "onLanguage:lean4"
    ],
    "main": "./dist/extension.js",
    "contributes": {},
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map"
    },
    "devDependencies": {
        "@types/node": "20.2.5",
        "@types/vscode": "^1.80.0",
        "ts-loader": "^9.5.4",
        "typescript": "^5.1.3",
        "webpack": "^5.104.1",
        "webpack-cli": "^6.0.1"
    }
}
