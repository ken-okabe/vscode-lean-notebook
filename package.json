{
    "name": "leannotebook",
    "displayName": "LeanNotebook",
    "description": "Rich notebook interface for Lean 4 based on VanJS",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:leannotebook.openPreview",
        "onLanguage:lean4"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "leannotebook.openPreview",
                "title": "LeanNotebook: Open Preview",
                "icon": "$(preview)"
            },
            {
                "command": "leannotebook.showSource",
                "title": "LeanNotebook: Show Source",
                "icon": "$(code)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "leannotebook.openPreview",
                    "group": "navigation",
                    "when": "resourceLangId == lean4"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@types/glob": "^8.1.0",
        "@types/node": "20.2.5",
        "@typescript-eslint/eslint-plugin": "^5.59.8",
        "@typescript-eslint/parser": "^5.59.8",
        "eslint": "^8.41.0",
        "glob": "^8.1.0",
        "typescript": "^5.1.3"
    },
    "dependencies": {
        "katex": "^0.16.8",
        "marked": "^9.0.0",
        "vanjs-core": "^1.2.3"
    }
}