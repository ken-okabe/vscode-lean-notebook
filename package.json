{
    "name": "leannotebook",
    "displayName": "LeanNotebook",
    "description": "Rich notebook interface for Lean 4 based on VanJS",
    "version": "0.12.7",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ken-okabe/vscode-lean-notebook"
    },
    "author": {
        "name": "Ken Okabe",
        "email": "kentechgeek@gmail.com"
    },
    "license": "MIT",
    "homepage": "https://github.com/ken-okabe/vscode-lean-notebook",
    "bugs": {
        "url": "https://github.com/ken-okabe/vscode-lean-notebook/issues"
    },
    "keywords": [
        "lean4",
        "lean",
        "theorem-proving",
        "formal-verification",
        "notebook",
        "interactive",
        "mathematics",
        "proof-assistant"
    ],
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#2563eb",
        "theme": "dark"
    },
    "publisher": "ken-okabe",
    "activationEvents": [
        "onCommand:leannotebook.openPreview",
        "onLanguage:lean4",
        "onLanguage:markdown"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "lean4",
                "aliases": [
                    "Lean 4",
                    "lean4"
                ],
                "extensions": [
                    ".lean"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "commands": [
            {
                "command": "leannotebook.openPreview",
                "title": "LeanNotebook: Open Preview",
                "icon": "$(preview)"
            },
            {
                "command": "leannotebook.showSource",
                "title": "LeanNotebook: Show Source",
                "icon": "$(code)"
            },
            {
                "command": "leannotebook.htmlExport",
                "title": "LeanNotebook: HTML Export",
                "icon": "$(export)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "leannotebook.openPreview",
                    "group": "navigation",
                    "when": "resourceLangId == lean4"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "node esbuild.config.js",
        "watch": "node esbuild.config.js --watch",
        "package": "node esbuild.config.js --production"
    },
    "devDependencies": {
        "@types/node": "20.2.5",
        "@types/vscode": "^1.80.0",
        "esbuild": "^0.19.0",
        "typescript": "^5.1.3"
    },
    "dependencies": {
        "marked": "^9.0.0",
        "mermaid": "^11.12.2",
        "vanjs-core": "^1.2.3",
        "vscode-languageclient": "^9.0.1"
    }
}